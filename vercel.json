{
  "version": 2,
  "rewrites": [
    {
      "source": "/en",
      "destination": "/en/index.html"
    },
    {
      "source": "/en/([^.]*)",
      "destination": "/en/index.html"
    },
    {
      "source": "/en/(.*)",
      "destination": "/en/$1"
    },
    {
      "source": "/",
      "destination": "/es/index.html"
    },
    {
      "source": "/([^.]*)",
      "destination": "/es/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/es/$1"
    }
  ]
}